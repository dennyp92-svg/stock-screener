// =============================================================================================================
// Supertrend + Hull MA + Risk Management
// -------------------------------------------------------------------------------------------------------------
// A trend-following STRATEGY that combines:
//   1) Supertrend  -- ATR-band trend filter, in the style popularized by KivancOzbilgic
//   2) Hull MA     -- nested-WMA smoothed trend, in the style popularized by InSilico
//   3) Risk Mgmt   -- percent-risk position sizing, ATR / fixed stops, R-multiple take-profit, optional trailing
//
// NOTE ON ATTRIBUTION: This is an independent implementation of the standard, publicly documented algorithms
// (Supertrend = ATR bands; Hull MA = WMA(2*WMA(n/2) - WMA(n), sqrt(n))). It is NOT a verbatim copy of any
// specific author's proprietary script. Verify behavior on your own charts before using it with real money.
// =============================================================================================================

//@version=5
strategy("Supertrend + Hull MA + Risk Management",
     overlay              = true,
     initial_capital      = 10000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 0,
     pyramiding           = 0,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.04,
     calc_on_every_tick   = false,
     process_orders_on_close = true)

// -------------------------------------------------------------------------------------------------------------
// INPUTS
// -------------------------------------------------------------------------------------------------------------
grpST   = "Supertrend (KivancOzbilgic style)"
stFactor   = input.float(3.0,   "ATR Multiplier",      minval = 0.1, step = 0.1, group = grpST)
stAtrLen   = input.int(10,      "ATR Length",          minval = 1,               group = grpST)
stChangeAtr= input.bool(true,   "Change ATR calc method (RMA vs SMA of TR)", group = grpST,
     tooltip = "ON = Wilder's RMA (ta.atr). OFF = simple moving average of True Range.")
stSrc      = input.source(hl2,  "Supertrend Source",   group = grpST)

grpHull = "Hull Moving Average (InSilico style)"
hullLen    = input.int(55,      "Hull MA Length",      minval = 1,               group = grpHull)
hullSrc    = input.source(close,"Hull MA Source",      group = grpHull)
useHullFilter = input.bool(true,"Require Hull slope to confirm entries", group = grpHull,
     tooltip = "Only take longs when Hull MA is rising and shorts when it is falling.")

grpTrade = "Trade Direction"
allowLong  = input.bool(true,   "Allow Long trades",   group = grpTrade)
allowShort = input.bool(false,  "Allow Short trades",  group = grpTrade)

grpRisk = "Risk Management"
riskPerTradePct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.0, step = 0.1, group = grpRisk,
     tooltip = "Position size is calculated so that a stop-out loses this % of current equity. Set 0 to disable sizing.")
stopType   = input.string("ATR", "Stop-loss type", options = ["ATR", "Percent", "Supertrend"], group = grpRisk)
stopAtrLen = input.int(14,       "Stop ATR Length",  minval = 1,               group = grpRisk)
stopAtrMult= input.float(2.0,    "Stop ATR Multiplier", minval = 0.1, step = 0.1, group = grpRisk)
stopPct    = input.float(3.0,    "Stop Percent (%)", minval = 0.1, step = 0.1, group = grpRisk)
useTrail   = input.bool(false,   "Trail the final leg (ATR)", group = grpRisk,
     tooltip = "When ON, the last remaining leg rides an ATR trailing stop instead of a fixed target.")
trailAtrMult = input.float(2.5,  "Trailing ATR Multiplier", minval = 0.1, step = 0.1, group = grpRisk)

grpProfit = "Profit Taking / Targets"
profitMode = input.string("Staged TP1/TP2/TP3", "Profit mode",
     options = ["Single R-multiple", "Staged TP1/TP2/TP3"], group = grpProfit)
rrRatio    = input.float(2.0,    "Single-mode take-profit R multiple", minval = 0.0, step = 0.1, group = grpProfit,
     tooltip = "Used only in 'Single R-multiple' mode. Target distance = R x stop distance. 0 disables it.")
tp1R       = input.float(1.0,    "TP1 — R multiple", minval = 0.1, step = 0.1, group = grpProfit)
tp1Pct     = input.float(40.0,   "TP1 — % of position to close", minval = 0.0, maxval = 100, step = 5, group = grpProfit)
tp2R       = input.float(2.0,    "TP2 — R multiple", minval = 0.1, step = 0.1, group = grpProfit)
tp2Pct     = input.float(30.0,   "TP2 — % of position to close", minval = 0.0, maxval = 100, step = 5, group = grpProfit)
tp3R       = input.float(3.0,    "TP3 — R multiple (closes remainder)", minval = 0.1, step = 0.1, group = grpProfit)
moveBE     = input.bool(true,    "Move stop to break-even after TP1 fills", group = grpProfit)

// -------------------------------------------------------------------------------------------------------------
// 1) SUPERTREND
//    Manual implementation so the "change ATR method" toggle is honored (RMA of TR vs SMA of TR).
// -------------------------------------------------------------------------------------------------------------
atr = stChangeAtr ? ta.atr(stAtrLen) : ta.sma(ta.tr(true), stAtrLen)

upperBasic = stSrc + stFactor * atr
lowerBasic = stSrc - stFactor * atr

var float up = na
var float dn = na
var int   trend = 1

// Lower band (support in an uptrend): can only rise while price holds above it.
up := na(up[1]) ? lowerBasic : (close[1] > up[1] ? math.max(lowerBasic, up[1]) : lowerBasic)
// Upper band (resistance in a downtrend): can only fall while price stays below it.
dn := na(dn[1]) ? upperBasic : (close[1] < dn[1] ? math.min(upperBasic, dn[1]) : upperBasic)

trend := na(trend[1]) ? 1 : trend[1]
trend := trend == -1 and close > dn[1] ? 1 : (trend == 1 and close < up[1] ? -1 : trend)

supertrend = trend == 1 ? up : dn

stLong  = trend ==  1 and trend[1] == -1   // trend flipped up
stShort = trend == -1 and trend[1] ==  1   // trend flipped down

plot(trend == 1 ? supertrend : na, "Supertrend Up",   color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)
plot(trend == -1 ? supertrend : na, "Supertrend Down", color = color.new(color.red,   0), style = plot.style_linebr, linewidth = 2)

// -------------------------------------------------------------------------------------------------------------
// 2) HULL MOVING AVERAGE
//    HMA = WMA( 2*WMA(src, n/2) - WMA(src, n), round(sqrt(n)) )
// -------------------------------------------------------------------------------------------------------------
hma(source, length) =>
    ta.wma(2 * ta.wma(source, math.floor(length / 2)) - ta.wma(source, length), math.round(math.sqrt(length)))

hull = hma(hullSrc, hullLen)
hullRising  = hull > hull[1]
hullFalling = hull < hull[1]

plot(hull, "Hull MA", color = hullRising ? color.new(color.aqua, 0) : color.new(color.orange, 0), linewidth = 2)

// -------------------------------------------------------------------------------------------------------------
// 3) ENTRY LOGIC (Supertrend flip, confirmed by Hull slope if enabled)
// -------------------------------------------------------------------------------------------------------------
longSignal  = stLong  and (not useHullFilter or hullRising)
shortSignal = stShort and (not useHullFilter or hullFalling)

// -------------------------------------------------------------------------------------------------------------
// 4) RISK MANAGEMENT: stop distance, position size, targets
// -------------------------------------------------------------------------------------------------------------
stopAtr = ta.atr(stopAtrLen)

// Stop distance (price units) for the signal bar, per selected method.
longStopDist =
     stopType == "ATR"        ? stopAtrMult * stopAtr :
     stopType == "Percent"    ? close * stopPct / 100 :
     math.max(close - up, syminfo.mintick)             // "Supertrend": distance to the trend line

shortStopDist =
     stopType == "ATR"        ? stopAtrMult * stopAtr :
     stopType == "Percent"    ? close * stopPct / 100 :
     math.max(dn - close, syminfo.mintick)

// Percent-risk position sizing: qty such that (stop distance * qty) = risk% of equity.
riskCapital = strategy.equity * riskPerTradePct / 100
longQty  = riskPerTradePct > 0 and longStopDist  > 0 ? riskCapital / longStopDist  : na
shortQty = riskPerTradePct > 0 and shortStopDist > 0 ? riskCapital / shortStopDist : na

// -------------------------------------------------------------------------------------------------------------
// 5) ORDER EXECUTION
// -------------------------------------------------------------------------------------------------------------
if allowLong and longSignal
    if allowShort
        strategy.close("Short", comment = "flip")
    qty = na(longQty) ? na : longQty
    strategy.entry("Long", strategy.long, qty = qty)

if allowShort and shortSignal
    if allowLong
        strategy.close("Long", comment = "flip")
    qty = na(shortQty) ? na : shortQty
    strategy.entry("Short", strategy.short, qty = qty)

// Freeze the stop distance, entry price, initial size and all target prices at the entry bar so they
// do not drift with later ATR readings. R = the frozen stop distance (1R risk).
var float longEntryPx   = na
var float longStopPrice = na
var float longR         = na
var float longInitSize  = na
var float longTP1       = na
var float longTP2       = na
var float longTP3       = na
var float longSingleTP  = na

var float shortEntryPx   = na
var float shortStopPrice = na
var float shortR         = na
var float shortInitSize  = na
var float shortTP1       = na
var float shortTP2       = na
var float shortTP3       = na
var float shortSingleTP  = na

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    // just went long
    longEntryPx   := strategy.position_avg_price
    longR         := longStopDist
    longStopPrice := longEntryPx - longR
    longInitSize  := strategy.position_size
    longTP1       := longEntryPx + tp1R * longR
    longTP2       := longEntryPx + tp2R * longR
    longTP3       := longEntryPx + tp3R * longR
    longSingleTP  := rrRatio > 0 ? longEntryPx + rrRatio * longR : na

if strategy.position_size < 0 and strategy.position_size[1] >= 0
    // just went short
    shortEntryPx   := strategy.position_avg_price
    shortR         := shortStopDist
    shortStopPrice := shortEntryPx + shortR
    shortInitSize  := math.abs(strategy.position_size)
    shortTP1       := shortEntryPx - tp1R * shortR
    shortTP2       := shortEntryPx - tp2R * shortR
    shortTP3       := shortEntryPx - tp3R * shortR
    shortSingleTP  := rrRatio > 0 ? shortEntryPx - rrRatio * shortR : na

// Break-even: once the position has been partially closed (TP1 filled), pull the stop to entry.
longBE  = moveBE and strategy.position_size > 0 and strategy.position_size < longInitSize  * 0.999
shortBE = moveBE and strategy.position_size < 0 and math.abs(strategy.position_size) < shortInitSize * 0.999

longStopEff  = longBE  ? longEntryPx  : longStopPrice
shortStopEff = shortBE ? shortEntryPx : shortStopPrice

// Scale-out sizes as ABSOLUTE quantities (percent of the ORIGINAL position), so TP2's size is not
// re-interpreted as a percent of whatever is left after TP1.
longTP1Qty  = longInitSize  * tp1Pct / 100
longTP2Qty  = longInitSize  * tp2Pct / 100
shortTP1Qty = shortInitSize * tp1Pct / 100
shortTP2Qty = shortInitSize * tp2Pct / 100

// ---- Exits ----
if strategy.position_size > 0
    if profitMode == "Staged TP1/TP2/TP3"
        if tp1Pct > 0
            strategy.exit("L-TP1", from_entry = "Long", qty = longTP1Qty, limit = longTP1, stop = longStopEff)
        if tp2Pct > 0
            strategy.exit("L-TP2", from_entry = "Long", qty = longTP2Qty, limit = longTP2, stop = longStopEff)
        if useTrail
            strategy.exit("L-TP3", from_entry = "Long", stop = longStopEff,
                 trail_price = close, trail_offset = trailAtrMult * stopAtr / syminfo.mintick)
        else
            strategy.exit("L-TP3", from_entry = "Long", limit = longTP3, stop = longStopEff)
    else
        if useTrail
            strategy.exit("Long Exit", from_entry = "Long", limit = longSingleTP, stop = longStopEff,
                 trail_price = close, trail_offset = trailAtrMult * stopAtr / syminfo.mintick)
        else
            strategy.exit("Long Exit", from_entry = "Long", stop = longStopEff, limit = longSingleTP)

if strategy.position_size < 0
    if profitMode == "Staged TP1/TP2/TP3"
        if tp1Pct > 0
            strategy.exit("S-TP1", from_entry = "Short", qty = shortTP1Qty, limit = shortTP1, stop = shortStopEff)
        if tp2Pct > 0
            strategy.exit("S-TP2", from_entry = "Short", qty = shortTP2Qty, limit = shortTP2, stop = shortStopEff)
        if useTrail
            strategy.exit("S-TP3", from_entry = "Short", stop = shortStopEff,
                 trail_price = close, trail_offset = trailAtrMult * stopAtr / syminfo.mintick)
        else
            strategy.exit("S-TP3", from_entry = "Short", limit = shortTP3, stop = shortStopEff)
    else
        if useTrail
            strategy.exit("Short Exit", from_entry = "Short", limit = shortSingleTP, stop = shortStopEff,
                 trail_price = close, trail_offset = trailAtrMult * stopAtr / syminfo.mintick)
        else
            strategy.exit("Short Exit", from_entry = "Short", stop = shortStopEff, limit = shortSingleTP)

// -------------------------------------------------------------------------------------------------------------
// 6) VISUALS
// -------------------------------------------------------------------------------------------------------------
staged = profitMode == "Staged TP1/TP2/TP3"

plot(strategy.position_size > 0 ? longStopEff  : na, "Long Stop",  color = color.new(longBE  ? color.blue : color.red, 20), style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size < 0 ? shortStopEff : na, "Short Stop", color = color.new(shortBE ? color.blue : color.red, 20), style = plot.style_linebr, linewidth = 2)

// Long targets
plot(strategy.position_size > 0 and staged        ? longTP1      : na, "Long TP1",    color = color.new(color.green, 55), style = plot.style_linebr)
plot(strategy.position_size > 0 and staged        ? longTP2      : na, "Long TP2",    color = color.new(color.green, 35), style = plot.style_linebr)
plot(strategy.position_size > 0 and staged and not useTrail ? longTP3 : na, "Long TP3", color = color.new(color.green, 10), style = plot.style_linebr)
plot(strategy.position_size > 0 and not staged    ? longSingleTP : na, "Long Target", color = color.new(color.green, 20), style = plot.style_linebr)
// Short targets
plot(strategy.position_size < 0 and staged        ? shortTP1      : na, "Short TP1",   color = color.new(color.green, 55), style = plot.style_linebr)
plot(strategy.position_size < 0 and staged        ? shortTP2      : na, "Short TP2",   color = color.new(color.green, 35), style = plot.style_linebr)
plot(strategy.position_size < 0 and staged and not useTrail ? shortTP3 : na, "Short TP3", color = color.new(color.green, 10), style = plot.style_linebr)
plot(strategy.position_size < 0 and not staged    ? shortSingleTP : na, "Short Target", color = color.new(color.green, 20), style = plot.style_linebr)

plotshape(allowLong  and longSignal,  "Long Entry",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(allowShort and shortSignal, "Short Entry", style = shape.triangledown, location = location.abovebar, color = color.new(color.red,   0), size = size.small)

// Alerts
alertcondition(longSignal,  "Long signal",  "Supertrend+Hull: LONG signal")
alertcondition(shortSignal, "Short signal", "Supertrend+Hull: SHORT signal")
